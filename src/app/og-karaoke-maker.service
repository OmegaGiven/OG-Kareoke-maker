[Unit]
Description=OG Karaoke Maker web app (lyric video pipeline)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/omegagiven/OG-Kareoke-maker/src/app
Environment=TRANSCRIBE_LOCAL=1
Environment=PATH=/home/omegagiven/ai-companion/whisper-env/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/home/omegagiven/ai-companion/comfyui-env/lib/python3.12/site-packages/nvidia/cublas/lib:/home/omegagiven/ai-companion/comfyui-env/lib/python3.12/site-packages/nvidia/cudnn/lib
ExecStart=/home/omegagiven/ai-companion/whisper-env/bin/uvicorn server:app --app-dir . --host 0.0.0.0 --port 8094
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
